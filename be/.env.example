APP_NAME=VLearn Tutor API
APP_ENV=development
HOST=0.0.0.0
PORT=8000

FRONTEND_ORIGIN=http://localhost:5173

STORAGE_DIR=app/storage/documents
METADATA_DIR=app/storage/metadata
DATABASE_PATH=app/storage/index/vlearn.db
EMBEDDING_CACHE_DIR=app/storage/model-cache
PAGE_CACHE_DIR=app/storage/page-cache
MAX_UPLOAD_MB=50

PRIMARY_PROVIDER=openai
ENABLE_GEMINI_FALLBACK=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=45

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=12
RERANKER_FINAL_N=6

RETRIEVAL_LEXICAL_TOP_K=20
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_FUSED_TOP_K=12
RETRIEVAL_FINAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.20

CHAT_RECENT_MESSAGE_LIMIT=8
CHAT_SUMMARY_TRIGGER_MESSAGES=12
CHAT_MAX_HISTORY_CHARS=16000
MAX_EVIDENCE_CHARS=24000
MAX_QUERY_CHARS=2000
MAX_SELECTED_TEXT_CHARS=6000

PRIMARY_TEXT_PROVIDER=openai
FALLBACK_TEXT_PROVIDER=gemini

ROUTER_PROVIDER=gemini
ROUTER_MODEL=
ROUTER_CONFIDENCE_THRESHOLD=0.72

VISION_PRIMARY_PROVIDER=gemini
VISION_FALLBACK_PROVIDER=openai
GEMINI_VISION_MODEL=
OPENAI_VISION_MODEL=

PAGE_RENDER_SCALE=1.6
REGION_RENDER_SCALE=2.0
MAX_VISUAL_IMAGE_BYTES=10000000
TEXT_SELECTION_MATCH_THRESHOLD=78
MAX_SELECTION_CHARS=6000

VERIFIER_ENABLED=true
VERIFIER_PROVIDER=openai
VERIFIER_MODEL=

ENABLE_DEBUG_ENDPOINTS=true

LOG_LEVEL=INFO
