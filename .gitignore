.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/
.vite/
coverage/

# Environment
.env
.env.*
!.env.example

# Runtime databases
*.db
*.sqlite
*.sqlite3

# Backend runtime storage
codebase/backend/app/storage/documents/*
codebase/backend/app/storage/cache/*
codebase/backend/app/storage/index/*
codebase/backend/app/storage/metadata/*
codebase/backend/app/storage/model-cache/*
codebase/backend/app/storage/page-cache/*
!codebase/backend/app/storage/**/.gitkeep

# Generated uploads/renders
uploads/
page-renders/
crops/
generated/

# Temporary files
*.tmp
*.bak
*.log
temp*
job.txt

# Evaluation runtime outputs
eval/results/*.json
!eval/results/.gitkeep
!eval/results/latest.json
!eval/results/term_search_latest.json
